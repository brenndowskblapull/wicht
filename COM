import pygame, math, time, hashlib, random, sys

pygame.init()

W, H = pygame.display.Info().current_w, pygame.display.Info().current_h
screen = pygame.display.set_mode((W, H), pygame.FULLSCREEN)
clock = pygame.time.Clock()

P = [4, 4, 120, 55, 4]
MIN = [1, 1, 50, 5, 0]
MAX = [30, 30, 200, 150, 30]
STEP = [1, 1, 10, 5, 1]

NAMES = [
    "W-Breite",
    "W-Länge",
    "Flitzstrecke",
    "Flitzgeschwindigkeit",
    "Krümmung"
]

BG = (225, 220, 205)

ki = True
show_ui = True
next_ki = 0

x, y = W / 2, H / 2
direction = random.random() * math.tau
start_direction = direction
distance = 0
hidden = 0
counter = 0

font = pygame.font.SysFont(None, 28)
small = pygame.font.SysFont(None, 22)

PX, PY, PW, PH = 15, 15, 370, 315

buttons = []

for i in range(5):
    yy = PY + 45 + i * 42
    buttons.append((
        pygame.Rect(PX + 10, yy, 42, 32),
        pygame.Rect(PX + 315, yy, 42, 32)
    ))

ki_button = pygame.Rect(PX + 10, PY + 270, 167, 32)
flitz_button = pygame.Rect(PX + 190, PY + 270, 167, 32)


def change(i, v):
    global ki
    P[i] = max(MIN[i], min(MAX[i], P[i] + v))
    ki = False


def flitz():
    global x, y, direction, start_direction, distance, hidden
    x = random.uniform(0, W)
    y = random.uniform(0, H)
    direction = random.random() * math.tau
    start_direction = direction
    distance = 0
    hidden = 0


def touch(pos):
    global ki

    if ki_button.collidepoint(pos):
        ki = not ki
        return

    if flitz_button.collidepoint(pos):
        flitz()
        return

    for i, (minus, plus) in enumerate(buttons):
        if minus.collidepoint(pos):
            change(i, -STEP[i])
            return
        if plus.collidepoint(pos):
            change(i, STEP[i])
            return


def draw_ui():
    r = pygame.Rect(PX, PY, PW, PH)

    pygame.draw.rect(screen, (238, 234, 220), r, border_radius=8)
    pygame.draw.rect(screen, (90, 85, 75), r, 2, border_radius=8)

    screen.blit(
        font.render("WICHT STEUERUNG", True, (20, 20, 20)),
        (PX + 10, PY + 10)
    )

    for i, (minus, plus) in enumerate(buttons):
        pygame.draw.rect(screen, (205, 200, 185), minus, border_radius=5)
        pygame.draw.rect(screen, (205, 200, 185), plus, border_radius=5)

        screen.blit(
            font.render("-", True, (20, 20, 20)),
            (minus.centerx - 5, minus.centery - 12)
        )

        screen.blit(
            font.render("+", True, (20, 20, 20)),
            (plus.centerx - 7, plus.centery - 12)
        )

        screen.blit(
            small.render(NAMES[i], True, (20, 20, 20)),
            (PX + 62, minus.centery - 9)
        )

        screen.blit(
            font.render(str(P[i]), True, (20, 20, 20)),
            (PX + 270, minus.centery - 12)
        )

    pygame.draw.rect(
        screen,
        (170, 165, 150) if ki else (205, 200, 185),
        ki_button,
        border_radius=5
    )

    pygame.draw.rect(
        screen,
        (190, 175, 145),
        flitz_button,
        border_radius=5
    )

    t = font.render("KI: AN" if ki else "KI: AUS", True, (20, 20, 20))
    screen.blit(
        t,
        (
            ki_button.centerx - t.get_width() // 2,
            ki_button.centery - t.get_height() // 2
        )
    )

    t = font.render("FLITZ", True, (20, 20, 20))
    screen.blit(
        t,
        (
            flitz_button.centerx - t.get_width() // 2,
            flitz_button.centery - t.get_height() // 2
        )
    )


running = True

while running:

    for e in pygame.event.get():

        if e.type == pygame.QUIT:
            running = False

        elif e.type == pygame.KEYDOWN:

            if e.key == pygame.K_ESCAPE:
                running = False

            elif e.key == pygame.K_TAB:
                show_ui = not show_ui

            elif e.key == pygame.K_SPACE:
                flitz()

        elif e.type == pygame.MOUSEBUTTONDOWN and e.button == 1:
            touch(e.pos)

    now = time.time()

    d = hashlib.sha256(
        f"{counter}{time.time_ns()}".encode()
    ).digest()

    counter = (
        counter +
        int.from_bytes(d[:8], "big")
    ) & 0xffffffffffffffff

    if ki and now >= next_ki:
        P[0] = 2 + d[0] % 9
        P[1] = 2 + d[1] % 9
        P[2] = 50 + d[2] % 151
        P[3] = 35 + d[3] % 116
        P[4] = d[4] % 16

        next_ki = now + random.uniform(.15, .45)

    width, height, flight, speed, curve = P

    if hidden:
        hidden -= 1

    else:

        if distance >= flight:
            hidden = random.randint(2, 6)
            flitz()

        progress = distance / max(flight, 1)

        direction = (
            start_direction +
            math.radians(curve) * progress
        )

        step = min(
            speed,
            flight - distance
        )

        x += math.cos(direction) * step
        y += math.sin(direction) * step

        x %= W
        y %= H

        distance += step

    screen.fill(BG)

    if not hidden:

        progress = min(
            distance / max(flight, 1),
            1
        )

        bw = max(
            1,
            int(width * (1 - progress))
        )

        bh = max(
            1,
            int(height * (1 - progress))
        )

        cx, cy = int(x), int(y)

        w = max(1, bw - 2)
        h = max(1, bh - 2)

        pygame.draw.rect(
            screen,
            (160, 160, 160),
            (
                cx - w // 2,
                cy - h // 2,
                w,
                h
            )
        )

        w = max(1, bw - 1)
        h = max(1, bh - 1)

        pygame.draw.rect(
            screen,
            (80, 80, 80),
            (
                cx - w // 2,
                cy - h // 2,
                w,
                h
            )
        )

        pygame.draw.rect(
            screen,
            (0, 0, 0),
            (
                cx - bw // 2,
                cy - bh // 2,
                bw,
                bh
            )
        )

    if show_ui:
        draw_ui()

    pygame.display.flip()
    clock.tick(144)

pygame.quit()
sys.exit()
