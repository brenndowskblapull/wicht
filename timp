import pygame
import random
import math
import time
import threading
import psutil
import subprocess
from pystray import Icon, MenuItem, Menu
from PIL import Image
from ping3 import ping

# Fenstergröße und Farben
WIDTH, HEIGHT = 100, 100
ICON_SIZE = (WIDTH, HEIGHT)
BLACK = (0, 0, 0)
TRANSPARENT = (0, 0, 0, 0)

# Wicht-Parameter
flitz_timer = 0
wicht_line = None
line_thickness = 8
flitz_delay = 6
pause_delay = 10  # Standardverzögerung

# Modus: 0 = Zufällig, 1 = CPU, 2 = Ping
mode = 0

# Pygame Oberfläche
pygame.init()
screen = pygame.Surface(ICON_SIZE, pygame.SRCALPHA)

# Icon-Setup
def create_image():
    return Image.new("RGBA", ICON_SIZE, TRANSPARENT)

def get_cpu_load():
    return psutil.cpu_percent(interval=0.1)

def get_ping_delay():
    try:
        result = ping("8.8.8.8", timeout=1)
        return result if result else 1
    except:
        return 1

def update_icon(icon):
    global flitz_timer, wicht_line, pause_delay

    screen.fill(TRANSPARENT)

    # Timer-Logik
    if flitz_timer > 0:
        flitz_timer -= 1
    elif wicht_line is not None:
        wicht_line = None
        flitz_timer = pause_delay

    if wicht_line is None and flitz_timer == 0:
        start_x = random.randint(10, WIDTH - 10)
        start_y = random.randint(10, HEIGHT - 10)
        is_curve = random.choice([True, False])

        if is_curve:
            angle = random.uniform(-0.3, 0.3)
            length = random.randint(25, 35)
            end_x = start_x + length * math.cos(angle)
            end_y = start_y + length * math.sin(angle)
        else:
            angle = random.uniform(0, 2 * math.pi)
            length = random.randint(25, 35)
            end_x = start_x + length * math.cos(angle)
            end_y = start_y + length * math.sin(angle)

        wicht_line = ((start_x, start_y), (end_x, end_y))
        flitz_timer = flitz_delay

    if wicht_line:
        shrink_factor = (flitz_delay - flitz_timer) / (flitz_delay / 3)
        start_x, start_y = wicht_line[0]
        current_end_x = int(wicht_line[1][0] + (start_x - wicht_line[1][0]) * shrink_factor)
        current_end_y = int(wicht_line[1][1] + (start_y - wicht_line[1][1]) * shrink_factor)
        pygame.draw.line(screen, BLACK, wicht_line[0], (current_end_x, current_end_y), line_thickness)

    icon.icon = Image.frombytes("RGBA", ICON_SIZE, pygame.image.tostring(screen, "RGBA"))

def on_quit(icon, item):
    icon.stop()

def set_mode_random(icon, item):
    global mode
    mode = 0

def set_mode_cpu(icon, item):
    global mode
    mode = 1

def set_mode_ping(icon, item):
    global mode
    mode = 2

def adjust_flitz_pause():
    global pause_delay
    while True:
        if mode == 0:
            pause_delay = random.randint(10, 30)
        elif mode == 1:
            cpu = get_cpu_load()
            pause_delay = max(3, int(30 - cpu / 3))  # Hohe CPU = weniger Pause
        elif mode == 2:
            delay = get_ping_delay()
            pause_delay = int(min(30, max(5, delay * 100)))  # Ping hoch = mehr Pause
        time.sleep(1)

# Tray-Menü
menu = Menu(
    MenuItem("Zufällig flitzen", set_mode_random),
    MenuItem("Synchron mit CPU", set_mode_cpu),
    MenuItem("Synchron mit Ping", set_mode_ping),
    Menu.SEPARATOR,
    MenuItem("Beenden", on_quit)
)

icon = Icon("Wicht", create_image(), menu=menu)

def run_animation():
    clock = pygame.time.Clock()
    while True:
        update_icon(icon)
        time.sleep(0.03)
        clock.tick(60)

def start_icon():
    threading.Thread(target=adjust_flitz_pause, daemon=True).start()
    icon_thread = threading.Thread(target=icon.run)
    icon_thread.daemon = True
    icon_thread.start()
    run_animation()

start_icon()



